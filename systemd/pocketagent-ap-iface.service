[Unit]
Description=PocketAgent create virtual AP interface (ap0)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/pocketagent
# Default: create ap0 on wlan0, override via /etc/default/pocketagent
# Idempotent: if ap0 exists already, do nothing.
ExecStart=/bin/bash -lc 'AP_IFACE="${POCKETAGENT_AP_IFACE:-ap0}"; UPLINK="${POCKETAGENT_UPLINK_IFACE:-wlan0}"; if /sbin/iw dev | grep -qE "^Interface[[:space:]]+${AP_IFACE}$"; then exit 0; fi; PHY=$(/sbin/iw dev "${UPLINK}" info 2>/dev/null | awk "/wiphy/ {print \"phy\"\$2; exit}"); if [ -n "${PHY}" ]; then /sbin/iw phy "${PHY}" interface add "${AP_IFACE}" type __ap; else /sbin/iw dev "${UPLINK}" interface add "${AP_IFACE}" type __ap; fi'
ExecStart=/bin/bash -lc 'AP_IFACE="${POCKETAGENT_AP_IFACE:-ap0}"; /sbin/ip link show "${AP_IFACE}" >/dev/null 2>&1 && /sbin/ip link set "${AP_IFACE}" up || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
