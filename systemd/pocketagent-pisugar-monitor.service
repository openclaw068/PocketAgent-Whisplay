[Unit]
Description=PocketAgent PiSugar Monitor (battery + display)
After=network-online.target pisugar-server.service pocketagent-display.service
Wants=network-online.target pisugar-server.service pocketagent-display.service

[Service]
Type=simple
WorkingDirectory=/opt/pocketagent
Environment=NODE_ENV=production
EnvironmentFile=-/etc/default/pocketagent

# Wait for PiSugar UDS/TCP to be available on boot.
# (Prevents early-start race where battery is null until later.)
ExecStartPre=/bin/sh -lc 'for i in $(seq 1 30); do [ -S "${POCKETAGENT_PISUGAR_SOCKET:-/tmp/pisugar-server.sock}" ] && exit 0; sleep 1; done; exit 0'

ExecStart=/usr/bin/node /opt/pocketagent/pocketagent/pisugar_monitor_daemon.js
Restart=on-failure
RestartSec=2
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
