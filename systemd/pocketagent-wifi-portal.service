[Unit]
Description=PocketAgent Wi-Fi Setup Portal (offline)
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pocketagent
EnvironmentFile=-/etc/default/pocketagent
ExecStart=/usr/bin/python3 /opt/pocketagent/wifi_portal/server.py
Restart=on-failure
RestartSec=2
# Run as root so nmcli/NetworkManager modifications work without polkit prompts.
User=root
Group=root

[Install]
WantedBy=multi-user.target
